# Servidor
NODE_ENV=development
PORT=3000
# Orígenes CORS permitidos, separados por coma (vacío = CORS abierto)
CORS_ORIGIN=

# Base de datos (debe coincidir con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager
DB_DATABASE=taskmanager

# JWT
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-frase-por-uno-muy-largo-y-aleatorio
JWT_EXPIRES_IN=1h
